      else if(d.evFre<20&&d.perp_pct<40){read='Cheap but realisation-dependent \u2014 value-trap watch';pill='pill-neg';}
      else{read='Mid-quality \u2014 transitioning';pill='pill-neu';}
      h+='<tr><td><span class="tk">'+d.ticker+'</span></td><td style="font-weight:bold">'+d.perp_pct+'%</td>'
        +'<td>'+fmt(d.evFre)+'x</td><td>'+d.freMgn+'%</td><td>'+d.fpaum+'</td><td>'+deltaCell(d.aumGrowth,'%')+'</td>'
        +'<td><span class="pill '+pill+'">'+read+'</span></td></tr>';
    });
    el('fr-quality-tbl').innerHTML=h+'</tbody>';
  }

  function renderInsurance(){
    var ins=DATA.insurance;
    var h='<thead><tr><th>TICKER</th><th>PLATFORM</th><th>GA ASSETS $B</th><th>SPREAD AUM %</th><th>NET SPREAD bps</th><th>SRE LTM $B</th><th>SRE GRW</th><th>POSTURE</th><th>NOTE</th></tr></thead><tbody>';
    ins.forEach(function(d){
      var pp=d.posture==='Engine'?'pill-pos':d.posture==='Scaling'||d.posture==='Emerging'?'pill-neu':d.posture==='Asset-light'?'pill-warn':'pill-neg';
      h+='<tr><td><span class="tk">'+d.ticker+'</span></td><td>'+esc(d.platform)+'</td>'
        +'<td style="font-weight:bold">$'+d.ga_assets+'</td><td>'+d.spread_aum_pct+'%</td>'
        +'<td>'+(d.net_spread_bps?d.net_spread_bps:'\u2014')+'</td><td>'+fmt(d.sre_ltm,2)+'</td>'
        +'<td>'+deltaCell(d.sre_growth,'%')+'</td><td><span class="pill '+pp+'">'+d.posture+'</span></td>'
        +'<td class="flag">'+esc(d.capital_note)+'</td></tr>';
    });
    el('fr-ins-tbl').innerHTML=h+'</tbody>';
    el('fr-ins-ga').innerHTML=hBarChart(ins.map(function(d){return {label:d.ticker,value:d.ga_assets,color:TKCOL[d.ticker]};}),{w:440,labelW:48});
    el('fr-ins-gr').innerHTML=hBarChart(ins.map(function(d){return {label:d.ticker,value:d.sre_growth,color:TKCOL[d.ticker]};}),{w:440,labelW:48,suffix:'%'});
  }

  function renderWealth(){
    var data=DATA.wealthFlows.quarterly;
    var keys=['BX','APO','ARES','OWL','KKR'], colors=keys.map(function(k){return TKCOL[k];});
    var rows=data.map(function(d){var o={label:d.period};keys.forEach(function(k){o[k]=d[k];});return o;});
    el('fr-wealth-chart').innerHTML=stackedBar(rows,keys,colors,{w:440,h:220});
    el('fr-wealth-legend').innerHTML=keys.map(function(k){return '<span><span class="lg-dot" style="background:'+TKCOL[k]+'"></span>'+k+'</span>';}).join('');
    var r=DATA.redemptions;
    var h='<thead><tr><th>VEHICLE</th><th>Q1</th><th>Q2</th><th>Q3</th><th>Q4</th><th>TREND</th></tr></thead><tbody>';
    r.forEach(function(d){var pp=d.trend==='improving'?'pill-pos':d.trend==='stable'?'pill-neu':'pill-neg';
      h+='<tr><td><span class="tk">'+esc(d.vehicle)+'</span></td><td>'+d.q1+'%</td><td>'+d.q2+'%</td><td>'+d.q3+'%</td><td>'+d.q4+'%</td><td><span class="pill '+pp+'">'+d.trend+'</span></td></tr>';});
    el('fr-redeem-tbl').innerHTML=h+'</tbody>';
  }

  function renderEarnings(){
    var p=DATA.peers.filter(function(d){return d.fre>0;});
    var rows=p.map(function(d){return {label:d.ticker,FRE:d.fre,SRE:d.sre,PII:d.pii};});
    el('fr-mix-chart').innerHTML=stackedBar(rows,['FRE','SRE','PII'],[COL.green,COL.steel,COL.gold],{w:440,h:220});
    var de=DATA.peers.filter(function(d){return d.de>0;});
    var h='<thead><tr><th>TK</th><th>FRE</th><th>CARRY/REAL.</th><th>DE</th><th>ANI</th><th>SBC*</th><th>SBC/ANI</th></tr></thead><tbody>';
    de.forEach(function(d){var ratio=d.sbc/d.ani, rc=ratio>0.25?COL.red:COL.gold;
      h+='<tr><td><span class="tk">'+d.ticker+'</span></td><td class="pos">'+fmt(d.fre,2)+'</td>'
        +'<td style="color:'+COL.steel+'">'+fmt(d.de-d.fre,2)+'</td><td style="font-weight:bold">'+fmt(d.de,2)+'</td>'
        +'<td>'+fmt(d.ani,2)+'</td><td class="neg">'+fmt(d.sbc,2)+'</td>'
        +'<td style="color:'+rc+';font-weight:bold">'+(ratio*100).toFixed(1)+'%</td></tr>';});
    el('fr-de-tbl').innerHTML=h+'</tbody>';
  }

  function renderMA(){
    var rows=DATA.ma.filter(function(d){return maRumours||d.closed;});
    var h='<thead><tr><th>STATUS</th><th>ACQUIRER</th><th>TARGET / TYPE</th><th>STRATEGY</th><th>VALUE</th><th>EV/FRE</th><th>EPS</th><th>SIGNAL</th></tr></thead><tbody>';
    rows.forEach(function(d){
      var stp=d.closed?'<span class="pill pill-pos">Closed</span>':'<span class="pill pill-warn">Signal</span>';
      var epsp=d.accretive?'pill-pos':'pill-neg';
      var tgt=d.target?esc(d.target):'<span style="color:'+COL.dim+';font-style:italic">Unknown \u2014 scouting</span>';
      h+='<tr><td>'+stp+'</td><td style="color:'+COL.gold+';font-weight:bold">'+esc(d.acquirer)+'</td>'
        +'<td>'+tgt+'</td><td style="color:'+COL.dim+';font-size:12px">'+esc(d.strategy)+'</td>'
        +'<td>'+(d.value?'$'+d.value+'B':'\u2014')+'</td><td>'+(d.evFre?d.evFre+'x':'\u2014')+'</td>'
        +'<td><span class="pill '+epsp+'">'+esc(d.epsImpact)+'</span></td>'
        +'<td class="flag">'+esc(d.signal)+'</td></tr>';
    });
    el('fr-ma-tbl').innerHTML=h+'</tbody>';
    /* comps chart: deal avg + current trading */
    var closed=DATA.ma.filter(function(d){return d.closed&&d.evFre;});
    var avg=closed.reduce(function(s,d){return s+d.evFre;},0)/closed.length;
    var bars=[{label:'Deal avg',value:+avg.toFixed(1),color:COL.dim}];
    ['BX','ARES','KKR','APO','OWL','CG'].forEach(function(tk){
      var d=DATA.peers.filter(function(x){return x.ticker===tk;})[0];
      if(d) bars.push({label:tk,value:d.evFre,color:TKCOL[tk]});});
    el('fr-ma-chart').innerHTML=hBarChart(bars,{w:600,labelW:90,suffix:'x',ref:+avg.toFixed(1)});
  }

  function renderAll(){ renderHeader(); renderSignals(); renderQuality(); renderInsurance();
    renderWealth(); renderEarnings(); renderMA(); }

  /* ---- tabs ---- */
  Array.prototype.forEach.call(document.querySelectorAll('.fr-altam .fr-tab'),function(btn){
    btn.addEventListener('click',function(){
      Array.prototype.forEach.call(document.querySelectorAll('.fr-altam .fr-tab'),function(b){b.classList.remove('active');});
      Array.prototype.forEach.call(document.querySelectorAll('.fr-altam .fr-panel'),function(p){p.classList.remove('active');});
      btn.classList.add('active');
      document.querySelector('.fr-altam .fr-panel[data-panel="'+btn.getAttribute('data-tab')+'"]').classList.add('active');
    });
  });
  el('fr-ma-toggle').addEventListener('click',function(){maRumours=!maRumours;
    this.textContent='Rumours: '+(maRumours?'ON':'OFF'); this.classList.toggle('on',maRumours); renderMA();});

  /* ---- staleness check ---- */
  function flagStale(){
    try{ var d=new Date(DATA.meta.as_of); var days=(Date.now()-d.getTime())/86400000;
      if(days>100){ var asof=el('fr-asof'); var s=document.createElement('span');
        s.className='stale'; s.textContent='\u26a0 '+Math.round(days)+'d old'; asof.parentNode.appendChild(s); } }catch(e){}
  }

  /* ---- load: try remote, fall back to embedded ---- */
  function boot(d){ DATA=d; renderAll(); flagStale(); }
  if(FR_DATA_URL){
    fetch(FR_DATA_URL,{cache:'no-store'}).then(function(r){return r.json();})
      .then(function(j){boot(j);})
      .catch(function(){boot(FALLBACK);});
  } else { boot(FALLBACK); }
})();
</script>
