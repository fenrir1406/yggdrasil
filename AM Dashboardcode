  /* ---- helpers ---- */
  function fmt(n,d){ if(n==null) return '\u2014'; return Number(n).toFixed(d==null?1:d); }
  function pctStr(n){ if(n==null) return '\u2014'; return (n>0?'+':'')+Number(n).toFixed(1)+'%'; }
  function deltaCell(v,suf){ if(v==null) return '<span style="color:'+COL.dim+'">\u2014</span>';
    var c=v>=0?'pos':'neg'; return '<span class="'+c+'">'+(v>0?'+':'')+fmt(v)+(suf||'')+'</span>'; }
  function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function el(id){ return document.getElementById(id); }

  /* ---- SVG mini chart builders (no libraries) ---- */
  function svgEl(w,h){ return '<svg viewBox="0 0 '+w+' '+h+'" width="100%" style="display:block;overflow:visible">'; }

  function vBarChart(rows, opts){ /* rows: [{label,value,color}] vertical bars */
    opts=opts||{}; var w=opts.w||440,h=opts.h||220,pad=opts.pad||28,top=14;
    var max=Math.max.apply(null,rows.map(function(r){return r.value;}))||1;
    var bw=(w-pad-8)/rows.length, gap=bw*0.32, plotH=h-pad-top;
    var s=svgEl(w,h);
    [0,0.5,1].forEach(function(f){ var y=top+plotH*(1-f);
      s+='<line x1="'+pad+'" y1="'+y+'" x2="'+w+'" y2="'+y+'" stroke="'+COL.border+'" stroke-width="1"/>';
      s+='<text x="'+(pad-4)+'" y="'+(y+3)+'" fill="'+COL.dim+'" font-size="9" text-anchor="end">'+ (max*f).toFixed(0) +'</text>'; });
    rows.forEach(function(r,i){ var bh=plotH*(r.value/max), x=pad+i*bw+gap/2, y=top+plotH-bh;
      s+='<rect x="'+x+'" y="'+y+'" width="'+(bw-gap)+'" height="'+Math.max(bh,1)+'" fill="'+(r.color||COL.steel)+'" rx="1"/>';
      s+='<text x="'+(x+(bw-gap)/2)+'" y="'+(y-4)+'" fill="'+COL.ink+'" font-size="9" text-anchor="middle">'+r.value+'</text>';
      s+='<text x="'+(x+(bw-gap)/2)+'" y="'+(h-8)+'" fill="'+COL.dim+'" font-size="9" text-anchor="middle">'+esc(r.label)+'</text>'; });
    return s+'</svg>';
  }

  function hBarChart(rows, opts){ /* horizontal bars [{label,value,color}] */
    opts=opts||{}; var w=opts.w||440,labelW=opts.labelW||120,rowH=26,pad=8;
    var h=rows.length*rowH+16, max=Math.max.apply(null,rows.map(function(r){return r.value;}))||1;
    var plotW=w-labelW-44, ref=opts.ref;
    var s=svgEl(w,h);
    if(ref!=null){ var rx=labelW+plotW*(ref/max);
      s+='<line x1="'+rx+'" y1="6" x2="'+rx+'" y2="'+(h-10)+'" stroke="'+COL.dim+'" stroke-dasharray="4 4" stroke-width="1"/>'; }
    rows.forEach(function(r,i){ var y=8+i*rowH, bw=plotW*(r.value/max);
      s+='<text x="'+(labelW-6)+'" y="'+(y+rowH/2)+'" fill="'+COL.dim+'" font-size="10" text-anchor="end" dominant-baseline="middle">'+esc(r.label)+'</text>';
      s+='<rect x="'+labelW+'" y="'+(y+5)+'" width="'+Math.max(bw,1)+'" height="'+(rowH-12)+'" fill="'+(r.color||COL.steel)+'" rx="1"/>';
      s+='<text x="'+(labelW+bw+5)+'" y="'+(y+rowH/2)+'" fill="'+COL.ink+'" font-size="10" dominant-baseline="middle">'+(opts.suffix?r.value+opts.suffix:r.value)+'</text>'; });
    return s+'</svg>';
  }

  function stackedBar(data, keys, colors, opts){ /* data:[{label,..keys}] */
    opts=opts||{}; var w=opts.w||440,h=opts.h||220,pad=28,top=14;
    var totals=data.map(function(d){var t=0;keys.forEach(function(k){t+=d[k]||0;});return t;});
    var max=Math.max.apply(null,totals)||1, bw=(w-pad-8)/data.length, gap=bw*0.4, plotH=h-pad-top;
    var s=svgEl(w,h);
    [0,0.5,1].forEach(function(f){var y=top+plotH*(1-f);
      s+='<line x1="'+pad+'" y1="'+y+'" x2="'+w+'" y2="'+y+'" stroke="'+COL.border+'"/>';
      s+='<text x="'+(pad-4)+'" y="'+(y+3)+'" fill="'+COL.dim+'" font-size="9" text-anchor="end">'+(max*f).toFixed(1)+'</text>';});
    data.forEach(function(d,i){ var x=pad+i*bw+gap/2, acc=0;
      keys.forEach(function(k,ki){ var v=d[k]||0; if(v<=0)return; var bh=plotH*(v/max), y=top+plotH-acc-bh;
        s+='<rect x="'+x+'" y="'+y+'" width="'+(bw-gap)+'" height="'+bh+'" fill="'+colors[ki]+'"/>'; acc+=bh; });
      s+='<text x="'+(x+(bw-gap)/2)+'" y="'+(h-8)+'" fill="'+COL.dim+'" font-size="9" text-anchor="middle">'+esc(d.label)+'</text>'; });
    return s+'</svg>';
  }

  function scatter(points, opts){ /* points:[{x,y,r,label,color}] */
    opts=opts||{}; var w=opts.w||1000,h=opts.h||380,padL=48,padB=40,padT=16,padR=20;
    var xmin=0,xmax=100,ymin=opts.ymin||15,ymax=opts.ymax||34;
    var plotW=w-padL-padR, plotH=h-padB-padT;
    function px(x){return padL+plotW*((x-xmin)/(xmax-xmin));}
    function py(y){return padT+plotH*(1-(y-ymin)/(ymax-ymin));}
    var s=svgEl(w,h);
    /* grid + axes */
    for(var gx=0;gx<=100;gx+=20){ var X=px(gx);
      s+='<line x1="'+X+'" y1="'+padT+'" x2="'+X+'" y2="'+(padT+plotH)+'" stroke="'+COL.border+'" stroke-width="1"/>';
      s+='<text x="'+X+'" y="'+(h-padB+16)+'" fill="'+COL.dim+'" font-size="10" text-anchor="middle">'+gx+'%</text>'; }
    for(var gy=Math.ceil(ymin/5)*5;gy<=ymax;gy+=5){ var Y=py(gy);
      s+='<line x1="'+padL+'" y1="'+Y+'" x2="'+(padL+plotW)+'" y2="'+Y+'" stroke="'+COL.border+'" stroke-width="1"/>';
      s+='<text x="'+(padL-6)+'" y="'+(Y+3)+'" fill="'+COL.dim+'" font-size="10" text-anchor="end">'+gy+'x</text>'; }
    /* quadrant divider at median-ish */
    var mx=px(50); s+='<line x1="'+mx+'" y1="'+padT+'" x2="'+mx+'" y2="'+(padT+plotH)+'" stroke="'+COL.gold+'" stroke-dasharray="3 5" stroke-width="1" opacity="0.5"/>';
    /* axis labels */
    s+='<text x="'+(padL+plotW/2)+'" y="'+(h-2)+'" fill="'+COL.dim+'" font-size="10" text-anchor="middle">PERPETUAL / PERMANENT CAPITAL (% of fee-paying AUM)</text>';
    s+='<text x="14" y="'+(padT+plotH/2)+'" fill="'+COL.dim+'" font-size="10" text-anchor="middle" transform="rotate(-90 14 '+(padT+plotH/2)+')">EV / FRE (x)</text>';
    /* points */
    points.forEach(function(p){ var X=px(p.x),Y=py(p.y),R=p.r;
      s+='<circle cx="'+X+'" cy="'+Y+'" r="'+R+'" fill="'+p.color+'" opacity="0.35"/>';
      s+='<circle cx="'+X+'" cy="'+Y+'" r="3" fill="'+p.color+'"/>';
      s+='<text x="'+X+'" y="'+(Y-R-5)+'" fill="'+COL.ink+'" font-size="11" font-weight="bold" text-anchor="middle">'+esc(p.label)+'</text>'; });
    return s+'</svg>';
  }

